# Copy to .env (gitignored) and fill in. Never commit real values.

GEMINI_API_KEY=

# console.neo4j.io -> create AuraDB Free instance -> Connect for these three.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# cloud.qdrant.io -> create free cluster -> API Keys for these two.
QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io
QDRANT_API_KEY=

CORS_ORIGINS=*
